# Database (SQLite for MVP; swap for postgres:// URL later without code changes)
DATABASE_URL=sqlite:///./data/app.db

# AI provider selection: "mock" (default, no API key needed) or "claude"
AI_PROVIDER=mock

# Only required when AI_PROVIDER=claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Upload provider selection: "mock" (default, no credentials needed, fully
# testable) or "youtube" (real YouTube Data API v3 upload via OAuth)
YOUTUBE_UPLOAD_PROVIDER=mock

# Analytics provider selection: "mock" (default, deterministic synthetic
# stats) or "youtube" (real YouTube Analytics API v2, reuses the same
# OAuth credentials as upload above)
YOUTUBE_ANALYTICS_PROVIDER=mock

# Only required when YOUTUBE_UPLOAD_PROVIDER=youtube and/or
# YOUTUBE_ANALYTICS_PROVIDER=youtube. Get CLIENT_ID/SECRET from Google
# Cloud Console (OAuth Client ID, type "Desktop app", with both the
# YouTube Data API v3 and YouTube Analytics API enabled on that project),
# then run scripts/youtube_oauth_setup.py locally (needs a browser) to
# get the refresh token — see README's Phase 5/6 setup section.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_DEFAULT_VISIBILITY=private
YOUTUBE_CATEGORY_ID=10
